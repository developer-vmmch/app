rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == doctorId;
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId is string && request.resource.data.authorId.size() <= 128;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId is string && request.resource.data.authorId.size() <= 128;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
